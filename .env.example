# ===== Discord =====
BOT_TOKEN=PUT_YOUR_BOT_TOKEN
CLIENT_ID=PUT_YOUR_CLIENT_ID

# ให้ /setup ใช้ได้คนเดียว (ใส่ Discord User ID)
SETUP_OWNER_ID=123456789012345678

# ===== PostgreSQL =====
# ถ้าฐานข้อมูลบังคับ SSL ให้ใส่ ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
